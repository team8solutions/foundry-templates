{
  "name": "symposia-nextjs-fullstack-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#sandbox/*": "./.symposia/sandbox/*.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test .tests/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx .tests/integration.ts",
    "db:setup": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "lucide-react": "1.56.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tough-cookie": "6.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
