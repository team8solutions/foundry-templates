# Outside AIT Foundry only (npm run db:setup writes .env.local); the platform sets these itself.
SYMPOSIA_APP=nextjs-starter
SYMPOSIA_ENV=dev
SYMPOSIA_DATA_BACKEND=postgres
SYMPOSIA_DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:5432/postgres
SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
